# ── 필수 ─────────────────────────────────────────────
DATABASE_FILE="data.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="openssl rand -base64 32 로 생성한 값"

# ── 선택: 실제 Gmail 연동 (없으면 데모 모드만 동작) ──
# Google Cloud Console → OAuth 클라이언트 생성, Gmail API 활성화,
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
# 테스트 모드(사용자 100명)로 운영 — gmail.readonly는 restricted scope
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── 선택: 실제 LLM 분류 (없으면 키워드 기반 모의 분류기 동작) ──
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-haiku-4-5-20251001"
